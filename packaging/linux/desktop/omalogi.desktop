[Desktop Entry]
Type=Application
Name=Omalogi
Comment=Logitech HID++ device control for Omarchy — remap buttons, DPI, SmartShift
Exec=omalogi-desktop
Icon=omalogi
Terminal=false
# Ties the running window (Wayland xdg-toplevel app_id / X11 WM_CLASS) back to
# this launcher so GNOME groups it under the Omalogi icon instead of a generic
# one. Must match `openlogi_core::brand::APP_ID`, the value the GUI advertises.
StartupWMClass=omalogi
Categories=Settings;HardwareSettings;
Keywords=logitech;mouse;hid;remap;dpi;
StartupNotify=true
